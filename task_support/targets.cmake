if(APPLE)
  target_link_libraries(OpenAL PRIVATE "-framework CoreFoundation")
endif()
add_executable(task_baseline task_support/baseline.cpp)
target_link_libraries(task_baseline PRIVATE OpenAL)
set_target_properties(task_baseline PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
if(TASK_TARGET_MODE)
  foreach(required_file core/effectslottail.cpp core/effectslottail.h tests/task_slot_tail.cpp examples/slot_tail_render.cpp)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${required_file}")
      message(FATAL_ERROR "Missing required source: ${required_file}")
    endif()
    file(SIZE "${CMAKE_CURRENT_SOURCE_DIR}/${required_file}" required_size)
    if(required_size EQUAL 0)
      message(FATAL_ERROR "Empty required source: ${required_file}")
    endif()
  endforeach()
  # SHARED OpenAL binds every translation unit, including this required addition.
  target_sources(OpenAL PRIVATE core/effectslottail.cpp)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/required_tail_header.cpp" "#include \"core/effectslottail.h\"\n")
  add_executable(task_target tests/task_slot_tail.cpp task_support/driver.c "${CMAKE_CURRENT_BINARY_DIR}/required_tail_header.cpp")
  set_source_files_properties(task_support/driver.c PROPERTIES LANGUAGE CXX)
  target_include_directories(task_target PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/common" "${CMAKE_CURRENT_SOURCE_DIR}/gsl/include" "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(task_target PRIVATE OpenAL)
  set_target_properties(task_target PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
  add_executable(task_example examples/slot_tail_render.cpp)
  target_link_libraries(task_example PRIVATE OpenAL)
  set_target_properties(task_example PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
endif()
