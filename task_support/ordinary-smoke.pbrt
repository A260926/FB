Film "image" "integer xresolution" [12] "integer yresolution" [8]
Sampler "random" "integer pixelsamples" [4]
Integrator "volpath" "integer maxdepth" [3]
LookAt 0 0 -4 0 0 0 0 1 0
Camera "perspective" "float fov" [40]
WorldBegin
LightSource "infinite" "rgb L" [1 1 1]
MakeNamedMedium "fog" "string type" ["heterogeneous"] "rgb sigma_a" [.1 .1 .1] "rgb sigma_s" [.9 .9 .9] "integer nx" [2] "integer ny" [2] "integer nz" [2] "float density" [1 1 1 1 1 1 1 1] "point p0" [-1 -1 -1] "point p1" [1 1 1]
AttributeBegin
MediumInterface "fog" ""
Material ""
Shape "sphere" "float radius" [1]
AttributeEnd
WorldEnd
