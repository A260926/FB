# transient-fog.pbrt
#
# Offline transient-rendering experiment: a short light pulse propagates
# through homogeneous fog.  All geometry, media and pulse definitions are
# contained in this file; no external scenes or services are needed.
#
# Units
#   World distances are metres: Integrator "metersperunit" is 1.
#   Flight time is seconds internally; film bins and pulse nodes use
#   nanoseconds.  The fog carries a group index of 1.3 (group velocity
#   c / 1.3), which is independent of the surface BSDF phase index "eta".

Film "transient"
    "integer xresolution" [64]
    "integer yresolution" [64]
    "string filename" ["transient-fog.csv"]
    "integer bins" [160]
    "float tstart" [0]
    "float binwidth" [0.05]
    "float scale" [1]

Sampler "random" "integer pixelsamples" [32]

Integrator "transientvolpath"
    "integer maxdepth" [8]
    "float rrthreshold" [1]
    "float metersperunit" [1]

# Fog filling the large boundary box below.
MakeNamedMedium "fog"
    "string type" "homogeneous"
    "color sigma_a" [0.02 0.03 0.04]
    "color sigma_s" [0.15 0.15 0.15]
    "float g" [0.3]
    "float groupindex" [1.3]

# The camera starts inside the fog, so camera rays begin in that medium.
MediumInterface "fog" "fog"
Camera "perspective" "float fov" [40]

WorldBegin

# Large material-less box: a pure medium boundary between the fog inside
# and vacuum outside.  It switches media without consuming scattering depth.
AttributeBegin
    Material "none"
    MediumInterface "fog" ""
    Shape "trianglemesh"
        "integer indices" [
            0 1 2 0 2 3   4 5 6 4 6 7
            0 1 5 0 5 4   2 3 7 2 7 6
            1 2 6 1 6 5   0 3 7 0 7 4
        ]
        "point P" [
            -50 -50 -40   50 -50 -40   50 50 -40   -50 50 -40
            -50 -50  60   50 -50  60   50 50  60   -50 50  60
        ]
AttributeEnd

# Matte back wall inside the fog, facing the camera (normal towards -z).
AttributeBegin
    Material "matte" "color Kd" [0.8 0.8 0.8]
    Shape "trianglemesh"
        "integer indices" [0 2 1 0 3 2]
        "point P" [
            -10 -10 15   10 -10 15   10 10 15   -10 10 15
        ]
AttributeEnd

# Finite point light with an explicit triangular pulse [0,1,2] ns.
AttributeBegin
    LightSource "point"
        "color I" [600 600 600]
        "float pulsetimes" [0 1 2]
        "float pulsevalues" [0 1 0]
        Translate 0 0 8
AttributeEnd

# Small constant diffuse area light with its own wider trapezoidal pulse.
AttributeBegin
    AreaLightSource "diffuse"
        "color L" [120 120 120]
        "integer nsamples" [1]
        "bool twosided" ["true"]
        "float pulsetimes" [0 0.5 2.5 3]
        "float pulsevalues" [0 1 1 0]
    Material "matte" "color Kd" [0.1 0.1 0.1]
    Translate 4 0 6
    Shape "trianglemesh"
        "integer indices" [0 1 2 0 2 3]
        "point P" [
            -1 -1 0   1 -1 0   1 1 0   -1 1 0
        ]
AttributeEnd

WorldEnd
