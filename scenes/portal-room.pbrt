# Portal-assisted environment sampling example.
#
# A closed room whose only opening is a doorway in the far wall. The
# infinite environment light is given a single rectangular portal that
# matches the doorway exactly, so direct-lighting samples are concentrated
# on the opening while the rest of the sky keeps a small chance of being
# sampled. The doorway and the lit patch it throws on the floor are visible
# from the camera inside the room.

Film "image" "integer xresolution" [96] "integer yresolution" [64]
Sampler "stratified" "integer xsamples" [2] "integer ysamples" [2]
Integrator "path" "integer maxdepth" [3]

LookAt 0 1.4 -3.2  0 1.1 2  0 1 0
Camera "perspective" "float fov" [50]

WorldBegin

# Constant environment with one rectangular portal (xmin, ymin, xmax, ymax,
# z in light-local space) matching the doorway opening below.
LightSource "infinite" "rgb L" [1.5 1.5 1.5]
    "float portals" [-0.6 0.2 0.6 1.8 2.0]
    "integer portalresolution" [64]
    "float portalmix" [0.9]

Material "matte" "rgb Kd" [0.72 0.70 0.66]

# Room interior: x in [-2.5, 2.5], y in [0, 3], z in [-3.5, 2]; doorway
# opening x in [-0.6, 0.6], y in [0.2, 1.8] in the z = 2 wall.
Shape "trianglemesh"
    "integer indices" [
        0 1 2 0 2 3          # floor
        4 5 6 4 6 7          # ceiling
        8 9 10 8 10 11       # back wall
        12 13 14 12 14 15    # left wall
        16 17 18 16 18 19    # right wall
        20 21 22 20 22 23    # front wall, below the doorway
        24 25 26 24 26 27    # front wall, above the doorway
        28 29 30 28 30 31    # front wall, left of the doorway
        32 33 34 32 34 35    # front wall, right of the doorway
    ]
    "point P" [
        -2.5 0 -3.5   2.5 0 -3.5   2.5 0 2   -2.5 0 2
        -2.5 3 -3.5  -2.5 3 2   2.5 3 2   2.5 3 -3.5
        -2.5 0 -3.5  -2.5 3 -3.5   2.5 3 -3.5   2.5 0 -3.5
        -2.5 0 -3.5  -2.5 0 2   -2.5 3 2   -2.5 3 -3.5
        2.5 0 -3.5   2.5 3 -3.5   2.5 3 2   2.5 0 2
        -2.5 0 2   2.5 0 2   2.5 0.2 2   -2.5 0.2 2
        -2.5 1.8 2   2.5 1.8 2   2.5 3 2   -2.5 3 2
        -2.5 0.2 2   -0.6 0.2 2   -0.6 1.8 2   -2.5 1.8 2
        0.6 0.2 2   2.5 0.2 2   2.5 1.8 2   0.6 1.8 2
    ]

WorldEnd
