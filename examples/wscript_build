# vim:set syntax=python:

import os.path

uselib = ['aubio']
uselib += ['JACK']

includes = ['../src']
utils_source = ['utils.c', 'jackio.c']
# aubiohpss is self-contained: no shared example helpers, no parse_args
hpss_source = ['aubiohpss.c']
programs_source = ctx.path.ant_glob('*.c',
        excl = utils_source + hpss_source)

# self-contained harmonic / percussive separation example
bld(features = 'c cprogram',
        source = hpss_source,
        target = 'aubiohpss',
        includes = includes,
        use = ['aubio'],
   )

# build examples
bld(features = 'c',
        source = utils_source,
        includes = includes,
        use = uselib,
        target = 'utilsio')

# loop over all *.c filenames in examples to build them all
for source_file in programs_source:
    target = os.path.basename(os.path.splitext(str(source_file))[0])
    bld(features = 'c cprogram',
            source = source_file,
            target = target,
            includes = includes,
            use = uselib + ['utilsio'],
       )
