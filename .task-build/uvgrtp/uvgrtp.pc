prefix=/usr/local
libdir=/usr/local/lib
includedir=/usr/local/include

Name: uvgrtp
Description: uvgRTP is a Real-Time Transport Protocol (RTP) library written in C++ with a focus on simple to use and high-efficiency media delivery over the internet
URL: https://github.com/ultravideo/uvgRTP
Version: 4.0.1
CFlags: -I${includedir}  -D__RTP_NO_CRYPTO__ -DUVGRTP_HAVE_SENDMSG=1
Libs: -L${libdir} -luvgrtp
Requires:

