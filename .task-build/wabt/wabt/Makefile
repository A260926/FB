# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /Volumes/UserFBWorkspace/questions/FS5AA0EBF89B7AU6657/attempts/20261126T161202474546Z/repo/.task-build/wabt && $(CMAKE_COMMAND) -P /Volumes/UserFBWorkspace/questions/FS5AA0EBF89B7AU6657/attempts/20261126T161202474546Z/repo/.task-build/wabt/CMakeFiles/VerifyGlobs.cmake
	cd /Volumes/UserFBWorkspace/questions/FS5AA0EBF89B7AU6657/attempts/20261126T161202474546Z/repo/.task-build/wabt && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

