	$(MAKE) $(MAKESILENT) -f CMakeFiles/taskbaseline.dir/build.make CMakeFiles/taskbaseline.dir/baseline.cpp.s
.PHONY : baseline.cpp.s

driver.o: driver.c.o
.PHONY : driver.o

# target to build an object file
driver.c.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tasktarget.dir/build.make CMakeFiles/tasktarget.dir/driver.c.o
.PHONY : driver.c.o

driver.i: driver.c.i
.PHONY : driver.i

# target to preprocess a source file
driver.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tasktarget.dir/build.make CMakeFiles/tasktarget.dir/driver.c.i
.PHONY : driver.c.i

driver.s: driver.c.s
.PHONY : driver.s

# target to generate assembly for a file
driver.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tasktarget.dir/build.make CMakeFiles/tasktarget.dir/driver.c.s
.PHONY : driver.c.s

